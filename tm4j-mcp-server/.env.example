# TM4J MCP Server - Environment Variables

# Jira Server Credentials
JIRA_URL=https://jira.example.com
JIRA_USERNAME=admin
JIRA_API_TOKEN=your-jira-api-token

# TM4J Credentials
TM4J_URL=https://tm4j.example.com
TM4J_USERNAME=admin
TM4J_API_TOKEN=your-tm4j-api-token

# Confluence Credentials
CONFLUENCE_URL=https://confluence.example.com
CONFLUENCE_USERNAME=admin
CONFLUENCE_API_TOKEN=your-confluence-api-token

# Storage
STORAGE_PATH=./data/test_sessions.db

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_CHECK_INTERVAL=300
SCHEDULER_MAX_CONCURRENT_SESSIONS=2

# Playwright
PLAYWRIGHT_DOCKER_GATEWAY=docker mcp gateway run --profile playwright
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000